{
    "compilerOptions": {
        // Paths
        "rootDir": "src",
        "outDir": "dist",

        // Language and Module
        "target": "es2021",
        "module": "Node16",
        "moduleResolution": "node16",
        "jsx": "react-jsx",

        // Type Checking
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitAny": false,

        // Output
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Module Interop
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "auto",

        // Misc
        "skipLibCheck": true,
        "types": []
    }
}
